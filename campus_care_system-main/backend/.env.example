# CampusCare API — copy this file to .env and adjust values
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=campuscare

# JWT — use a long random string in any shared or production environment
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Frontend origin for CORS (Vite default)
CORS_ORIGIN=http://localhost:5173

# Uploaded complaint photos (served only through authenticated routes)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
